		<properties node_id="6" format="literal">{'auto_commit': True, 'color_by_class': True, 'controlAreaVisible': True, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x03z\x00\x00\x00\x8f\x00\x00\x06\x9b\x00\x00\x02\xa0\x00\x00\x03{\x00\x00\x00\xac\x00\x00\x06\x9a\x00\x00\x02\x9f\x00\x00\x00\x00\x00\x00\x00\x00\x07\x80\x00\x00\x03{\x00\x00\x00\xac\x00\x00\x06\x9a\x00\x00\x02\x9f', 'select_rows': True, 'show_attribute_labels': True, 'show_distributions': False, 'stored_selection': {'rows': [], 'columns': []}, 'stored_sort': [], '__version__': 1}</properties>
		<properties node_id="7" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x02W\x00\x00\x00\x1d\x00\x00\x073\x00\x00\x04~\x00\x00\x02W\x00\x00\x00\x1d\x00\x00\x073\x00\x00\x04~\x00\x00\x00\x00\x00\x00\x00\x00\x07\x80\x00\x00\x02W\x00\x00\x00\x1d\x00\x00\x073\x00\x00\x04~', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import pandas as pd\nfrom Orange.data import Table, Domain, ContinuousVariable, StringVariable, DiscreteVariable\nimport re\n\ndef format_chaine(chaine):\n    \n    chaine = str(chaine)\n    if isinstance(chaine, str):\n        # Utiliser une expression régulière pour extraire les valeurs\n        pattern = r"\\[(\\d+)\\s\\|\\s([\\d\\.]+)\\]\\s\\{(\\d+)\\}"\n        match = re.match(pattern, chaine)\n    \n        # Si une correspondance est trouvée, extraire les valeurs\n        if match:\n            num1 = int(match.group(1))  # Premier nombre (entier)\n            num2 = float(match.group(2))  # Deuxième nombre (flottant)\n            num3 = float(match.group(3))  # Troisième nombre (entier)\n    return[num1, num2, num3]\n        \n# Convertir Orange Table en pandas DataFrame\nl = []\nfor row in in_data:\n    l.append(format_chaine(row))\n    \ndf = pd.DataFrame(l)\n\n# Récupérer les valeurs réelles et prédites\nX = df[0]\nactual_values = df[1]  # Remplacez "target" par le nom de votre colonne réelle\npredicted_values = df[2]  # Remplacez "Prediction" par le nom de votre colonne de prédictions\n\n\n# Créer un DataFrame combiné avec une colonne \'Type\' pour différencier Réel et Prédit\ncombined_df = pd.concat([\n    pd.DataFrame({"X": X, "Y": actual_values, "Type": "Real"}),  # Points réels\n    pd.DataFrame({"X": X, "Y": predicted_values, "Type": "Prediction"})  # Points prédits\n])\n\n# Convertir le DataFrame combiné en Orange Table\n# Définir le domaine avec "Type" comme variable discrète\ndomain = Domain(\n    [ContinuousVariable("X"), ContinuousVariable("Y")],  # Attributs\n    class_vars=[DiscreteVariable("Type", values=["Real", "Prediction"])]  # Type devient une classe catégorielle\n)\n\n# Créer une table Orange avec les bonnes conversions\nout_data = Table.from_numpy(\n    domain,\n    combined_df[["X", "Y"]].to_numpy(),                  # Attributs : X, Y\n    Y=combined_df["Type"].replace({"Real": 0, "Prediction": 1}).to_numpy()  # Encodage des catégories en indices\n)\n\n# Afficher la table\nprint(out_data)\n\n', 'filename': None}], 'scriptText': 'import pandas as pd\nfrom Orange.data import Table, Domain, ContinuousVariable, StringVariable, DiscreteVariable\nimport re\n\ndef format_chaine(chaine):\n    \n    chaine = str(chaine)\n    if isinstance(chaine, str):\n        # Utiliser une expression régulière pour extraire les valeurs\n        pattern = r"\\[(\\d+)\\s\\|\\s([\\d\\.]+)\\]\\s\\{(\\d+)\\}"\n        match = re.match(pattern, chaine)\n    \n        # Si une correspondance est trouvée, extraire les valeurs\n        if match:\n            num1 = int(match.group(1))  # Premier nombre (entier)\n            num2 = float(match.group(2))  # Deuxième nombre (flottant)\n            num3 = float(match.group(3))  # Troisième nombre (entier)\n    return[num1, num2, num3]\n        \n# Convertir Orange Table en pandas DataFrame\nl = []\nfor row in in_data:\n    l.append(format_chaine(row))\n    \ndf = pd.DataFrame(l)\n\n# Récupérer les valeurs réelles et prédites\nX = df[0]\nactual_values = df[1]  # Remplacez "target" par le nom de votre colonne réelle\npredicted_values = df[2]  # Remplacez "Prediction" par le nom de votre colonne de prédictions\n\n\n# Créer un DataFrame combiné avec une colonne \'Type\' pour différencier Réel et Prédit\ncombined_df = pd.concat([\n    pd.DataFrame({"X": X, "Y": actual_values, "Type": "Real"}),  # Points réels\n    pd.DataFrame({"X": X, "Y": predicted_values, "Type": "Prediction"})  # Points prédits\n])\n\n# Convertir le DataFrame combiné en Orange Table\n# Définir le domaine avec "Type" comme variable discrète\ndomain = Domain(\n    [ContinuousVariable("X"), ContinuousVariable("Y")],  # Attributs\n    class_vars=[DiscreteVariable("Type", values=["Real", "Prediction"])]  # Type devient une classe catégorielle\n)\n\n# Créer une table Orange avec les bonnes conversions\nout_data = Table.from_numpy(\n    domain,\n    combined_df[["X", "Y"]].to_numpy(),                  # Attributs : X, Y\n    Y=combined_df["Type"].replace({"Real": 0, "Prediction": 1}).to_numpy()  # Encodage des catégories en indices\n)\n\n# Afficher la table\nprint(out_data)\n\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\x9e\x00\x00\x00^\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
