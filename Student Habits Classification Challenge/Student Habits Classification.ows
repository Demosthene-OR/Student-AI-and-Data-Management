		<properties node_id="3" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x020\x00\x00\x01\x14\x00\x00\x05O\x00\x00\x03k\x00\x00\x020\x00\x00\x01\x14\x00\x00\x05O\x00\x00\x03k\x00\x00\x00\x00\x00\x00\x00\x00\x07\x80\x00\x00\x020\x00\x00\x01\x14\x00\x00\x05O\x00\x00\x03k', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': 'import numpy as np\nimport pandas as pd\nfrom Orange.data import Table, Domain, ContinuousVariable, StringVariable\n\nattrs = [a for a in in_data.domain.attributes if a.is_continuous]\nX = in_data.transform(Domain(attrs)).X\n\ndf = pd.DataFrame(X, columns=[a.name for a in attrs])\ncorr = df.corr().fillna(0)\n\nnew_attrs = [ContinuousVariable(name) for name in corr.columns]\nmeta_var = StringVariable("variable")\nnew_domain = Domain(new_attrs, metas=[meta_var])\n\nmetas = np.array(corr.index, dtype=object).reshape(-1, 1)\nout_data = Table.from_numpy(new_domain, corr.to_numpy(), metas=metas)\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa1\x00\x00\x00a\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
